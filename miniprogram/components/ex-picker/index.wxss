.mask {
  position: fixed;
  inset: 0;
  background: var(--mask);
  z-index: 50;
  opacity: 0;
  transition: opacity 0.25s;
}
.mask--show { opacity: 1; }

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 76%;
  background: var(--surface-container-high);  /* 弹层：surface-container-high */
  z-index: 51;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(102%);
  transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.3, 1);
  display: flex;
  flex-direction: column;
}
.sheet--show { transform: translateY(0); }

.sheet-head {
  padding: 28rpx 32rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--outline);
  flex-shrink: 0;
}
.t { font-size: 32rpx; font-weight: 600; color: var(--on-surface); }
.x {
  width: 88rpx; height: 88rpx;
  min-width: 88rpx;
  padding: 0;
  margin: 0;
  border: none;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--surface-container-highest);
  color: var(--on-surface-variant);
  font-size: 26rpx;
  line-height: 1;
}
.x::after { border: none; }

.search { padding: 20rpx 32rpx; flex-shrink: 0; }
.search-input {
  background: var(--surface-container-highest);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--on-surface);
}

.list { flex: 1; }
.none { text-align: center; color: var(--on-surface-muted); font-size: 26rpx; padding: 60rpx 0; }
