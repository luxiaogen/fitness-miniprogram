.ls { padding: 48rpx 32rpx; }

.ls--loading {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.ls-skeleton {
  height: 140rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, var(--surface-container) 25%, var(--surface-container-high) 37%, var(--surface-container) 63%);
  background-size: 400% 100%;
  animation: ls-shimmer 1.4s ease infinite;
}
@keyframes ls-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.ls--error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.ls-icon { font-size: 64rpx; }
.ls-text { font-size: 28rpx; color: var(--on-surface-variant); }
.ls-retry {
  margin-top: 8rpx;
  min-width: 160rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border: none;
  border-radius: 999rpx;
  background: var(--surface-container-high);
  color: var(--primary);
  font-size: 28rpx;
}
.ls-retry::after { border: none; }
