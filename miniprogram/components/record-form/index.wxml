<view class="mask {{visible ? 'mask--show' : ''}}" bindtap="onClose" />
<view class="sheet {{visible ? 'sheet--show' : ''}}" catchtouchmove="noop">
  <view class="sheet-head">
    <text class="t">配置训练参数</text>
    <view class="x" bindtap="onClose">✕</view>
  </view>

  <scroll-view scroll-y class="body">
    <view wx:if="{{exercise}}" class="picked">
      <image class="picked-thumb" src="{{exercise.image}}" mode="aspectFill" />
      <view>
        <view class="picked-name">{{exercise.nameZh}}</view>
        <view class="picked-sub">{{exercise.bodyPartZh}} · {{exercise.equipmentZh}}</view>
      </view>
    </view>

    <view class="row">
      <text class="k">组数</text>
      <view class="stepper">
        <view class="step-btn" data-field="sets" data-delta="-1" bindtap="step">−</view>
        <text class="step-val">{{sets}}</text>
        <view class="step-btn" data-field="sets" data-delta="1" bindtap="step">＋</view>
      </view>
    </view>
    <view class="row">
      <text class="k">每组次数</text>
      <view class="stepper">
        <view class="step-btn" data-field="reps" data-delta="-1" bindtap="step">−</view>
        <text class="step-val">{{reps}}</text>
        <view class="step-btn" data-field="reps" data-delta="1" bindtap="step">＋</view>
      </view>
    </view>
    <view class="row">
      <text class="k">重量（0 为自重）</text>
      <view class="unit">
        <input class="unit-input" type="digit" value="{{weight}}" data-field="weight" bindinput="onNumberInput" />
        <text class="unit-text">kg</text>
      </view>
    </view>
    <view class="row">
      <text class="k">预计时长</text>
      <view class="unit">
        <input class="unit-input" type="number" value="{{duration}}" data-field="duration" bindinput="onNumberInput" />
        <text class="unit-text">分钟</text>
      </view>
    </view>
    <textarea
      class="note"
      placeholder="备注（可选）：如发力感受、组间休息、注意事项"
      value="{{note}}"
      bindinput="onNoteInput"
      maxlength="200"
    />
  </scroll-view>

  <view class="foot">
    <button class="btn-primary" bindtap="onConfirm">确定添加</button>
  </view>
</view>
