.mask {
  position: fixed;
  inset: 0;
  background: var(--mask);
  z-index: 52;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.mask--show { opacity: 1; pointer-events: auto; }

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 82%;
  background: var(--surface-container-high);
  z-index: 53;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(102%);
  transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.3, 1);
  display: flex;
  flex-direction: column;
}
.sheet--show { transform: translateY(0); }

.sheet-head {
  padding: 28rpx 32rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--outline);
  flex-shrink: 0;
}
.t { font-size: 32rpx; font-weight: 600; color: var(--on-surface); }
.x {
  width: 88rpx; height: 88rpx;
  min-width: 88rpx;
  padding: 0;
  margin: 0;
  border: none;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--surface-container-highest);
  color: var(--on-surface-variant);
  font-size: 26rpx;
  line-height: 1;
}
.x::after { border: none; }

.body { flex: 1; padding-bottom: 24rpx; }

.picked {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--primary-container);  /* primary-container */
  border-radius: 20rpx;
  margin: 24rpx 32rpx 4rpx;
  padding: 20rpx 24rpx;
}
.picked-thumb { width: 88rpx; height: 88rpx; border-radius: 16rpx; background: #FFFFFF; }
.picked-name { font-size: 30rpx; font-weight: 600; color: var(--on-primary-container); }
.picked-sub { font-size: 24rpx; color: var(--on-surface-variant); margin-top: 4rpx; }

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid var(--outline-variant);
}
.k { font-size: 28rpx; color: var(--on-surface); }

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--outline);
  border-radius: 16rpx;
  overflow: hidden;
}
.step-btn {
  width: 88rpx; height: 88rpx;
  min-width: 88rpx;
  padding: 0;
  margin: 0;
  border: none;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-container-highest);
  color: var(--primary);
  font-size: 32rpx;
  line-height: 1;
}
.step-btn::after { border: none; }
.step-btn--disabled { opacity: 0.35; }
.step-val { width: 88rpx; text-align: center; font-size: 30rpx; color: var(--on-surface); }

.unit { display: flex; align-items: center; gap: 12rpx; }
.unit-input {
  width: 140rpx;
  border: 1rpx solid var(--outline);
  background: var(--surface-container-highest);
  border-radius: 16rpx;
  height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--on-surface);
}
.unit-text { font-size: 26rpx; color: var(--on-surface-muted); }

.note {
  margin: 24rpx 32rpx 0;
  width: auto;
  background: var(--surface-container-highest);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--on-surface);
  min-height: 120rpx;
}

.foot { padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); flex-shrink: 0; }
