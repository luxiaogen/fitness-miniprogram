<view class="page theme-{{theme}}">
  <view class="search-wrap">
    <input
      class="search-input"
      placeholder="搜索动作、肌群或器械"
      value="{{keyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <scroll-view scroll-x class="filter-row" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{filters}}"
      wx:key="*this"
      class="chip {{activeFilter === item ? 'chip--active' : ''}}"
      data-f="{{item}}"
      bindtap="onFilterTap"
    >{{filterLabels[item]}}</view>
  </scroll-view>

  <view class="count">共 {{list.length}} 个动作 · 数据来源 exercises-dataset</view>

  <view class="list">
    <ex-item
      wx:for="{{list}}"
      wx:key="id"
      exercise="{{item}}"
      noted="{{!!notedMap[item.id]}}"
      bind:select="onSelect"
    />
    <empty wx:if="{{!list.length}}" icon="🔍" text="未找到匹配的动作" sub="换个关键词试试" />
  </view>

  <view class="footer-space" />
</view>
