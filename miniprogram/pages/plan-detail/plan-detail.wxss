.header {
  background: var(--surface);
  padding: 32rpx 32rpx 28rpx;
  border-bottom: 1rpx solid var(--outline-variant);
}
.name { font-size: 44rpx; font-weight: 700; color: var(--on-surface); letter-spacing: -0.01em; }
.desc { font-size: 26rpx; color: var(--on-surface-variant); line-height: 1.6; margin-top: 12rpx; }
.tags { display: flex; gap: 12rpx; margin-top: 16rpx; flex-wrap: wrap; }

.info-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.info-row { display: flex; padding: 14rpx 0; }
.k { width: 150rpx; font-size: 26rpx; color: var(--on-surface-muted); flex-shrink: 0; }
.v { flex: 1; font-size: 26rpx; color: var(--on-surface); line-height: 1.5; }

.feature { display: flex; gap: 16rpx; padding: 10rpx 0; }
.feature-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  flex-shrink: 0;
  margin-top: 12rpx;
}
.feature-text { flex: 1; font-size: 26rpx; color: var(--on-surface-variant); line-height: 1.6; }

.day-block { margin-top: 8rpx; }
.day-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 20rpx 28rpx 0;
}
.day-name { font-size: 30rpx; font-weight: 700; color: var(--primary); }
.day-focus { font-size: 24rpx; color: var(--on-surface-muted); }

.day-card { padding-top: 4rpx; padding-bottom: 4rpx; }
.ex-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--outline-variant);
}
.ex-row:last-child { border-bottom: none; }
.ex-thumb { width: 88rpx; height: 88rpx; border-radius: 14rpx; background: #FFFFFF; flex-shrink: 0; }
.ex-info { flex: 1; min-width: 0; }
.ex-name { font-size: 28rpx; font-weight: 600; color: var(--on-surface); }
.ex-spec { font-size: 25rpx; color: var(--primary); font-weight: 500; margin-top: 4rpx; }
.ex-note {
  font-size: 23rpx;
  color: var(--on-surface-muted);
  margin-top: 6rpx;
  line-height: 1.5;
}
.arrow-icon {
  width: 14rpx; height: 14rpx;
  border-top: 3rpx solid var(--on-surface-muted);
  border-right: 3rpx solid var(--on-surface-muted);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.cta { padding: 28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); }
.btn-applied { background: var(--surface-container-high); color: var(--primary); border: 1rpx solid var(--primary-border); }
.cta-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--on-surface-muted);
  margin-top: 16rpx;
}
