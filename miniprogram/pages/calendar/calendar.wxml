<view class="page theme-{{theme}}">
  <view class="card cal-card">
    <view class="cal-head">
      <view class="arrow" data-d="-1" bindtap="onShiftMonth"><view class="arrow-icon arrow-icon--left" /></view>
      <view class="month">{{monthText}}</view>
      <view class="arrow" data-d="1" bindtap="onShiftMonth"><view class="arrow-icon arrow-icon--right" /></view>
    </view>
    <view class="grid">
      <view wx:for="{{weekLabels}}" wx:key="*this" class="wk">{{item}}</view>
      <view
        wx:for="{{cells}}"
        wx:key="ds"
        class="cell {{item.dim ? 'cell--dim' : ''}} {{item.isToday ? 'cell--today' : ''}} {{item.isSel ? 'cell--sel' : ''}}"
        data-ds="{{item.ds}}"
        data-dim="{{item.dim}}"
        bindtap="onSelectDay"
      >
        {{item.day}}
        <view wx:if="{{item.has}}" class="dot" />
      </view>
    </view>
  </view>

  <view class="sec-title">
    {{selLabel}} 训练详情
    <text class="sec-sub" wx:if="{{selRecords.length}}"> · {{selRecords.length}} 个动作 / {{selSets}} 组 / 约 {{selDuration}} 分钟</text>
  </view>
  <view class="card detail-card">
    <log-item
      wx:for="{{selRecords}}"
      wx:key="_id"
      record="{{item}}"
      compact
    />
    <empty wx:if="{{!selRecords.length}}" icon="📅" text="当天没有训练记录" />
  </view>
</view>
