.seg {
  display: flex;
  background: var(--surface-container);
  border: 1rpx solid var(--outline-variant);
  border-radius: 9999rpx;
  padding: 4rpx;
  margin: 24rpx 24rpx 0;
}
.seg-item {
  flex: 1;
  min-height: 88rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  text-align: center;
  font-size: 28rpx;
  border-radius: 9999rpx;
  color: var(--on-surface-variant);
  line-height: 88rpx;
}
.seg-item::after { border: none; }
.seg-item--active {
  background: var(--primary);
  color: var(--on-primary);
  font-weight: 600;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 24rpx 24rpx 0;
}
.stat-card {
  background: var(--surface-container);
  border: 1rpx solid var(--outline-variant);
  border-radius: 24rpx;
  padding: 28rpx;
  position: relative;
  overflow: hidden;
}
.stat-card::after {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: var(--primary);
}
.v { font-size: 52rpx; font-weight: 700; color: var(--primary); letter-spacing: -0.01em; }
.u { font-size: 24rpx; font-weight: 400; color: var(--on-surface-muted); margin-left: 6rpx; }
.k { font-size: 24rpx; color: var(--on-surface-variant); margin-top: 6rpx; }

.week-chart {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  height: 220rpx;
  padding: 20rpx 8rpx 0;
}
.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  height: 100%;
  justify-content: flex-end;
}
.bar {
  width: 70%;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: var(--chart-fill);
  position: relative;
}
.bar-val {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: var(--on-surface-variant);
}
.d { font-size: 22rpx; color: var(--on-surface-muted); }

.bar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}
.lbl { width: 88rpx; font-size: 25rpx; color: var(--on-surface-variant); text-align: right; flex-shrink: 0; }
.track { flex: 1; height: 32rpx; background: var(--surface-container-high); border-radius: 9999rpx; overflow: hidden; }
.fill {
  height: 100%;
  border-radius: 9999rpx;
  background: var(--chart-fill-x);
  min-width: 4rpx;
  transition: width 0.4s ease;
}
.val { width: 68rpx; font-size: 24rpx; color: var(--on-surface-variant); flex-shrink: 0; }

/* 外观设置卡 */
.theme-card { padding: 20rpx; }
.theme-options { display: flex; gap: 20rpx; }
.theme-option {
  flex: 1;
  min-height: 128rpx;
  padding: 24rpx 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border-radius: 16rpx;
  background: var(--surface-container-high);
  border: 1rpx solid var(--outline-variant);
  line-height: normal;
}
.theme-option::after { border: none; }
.theme-option--active {
  background: var(--primary-container);
  border-color: var(--primary-border);
}
.theme-icon { font-size: 44rpx; }
.theme-label { font-size: 24rpx; color: var(--on-surface-variant); }
.theme-option--active .theme-label { color: var(--on-primary-container); font-weight: 600; }
